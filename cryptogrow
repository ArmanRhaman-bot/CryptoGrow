<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Reward Dashboard</title>

<script src="https://cdn.tailwindcss.com"></script>

<style>
  body { transition: all 0.3s ease; }
</style>
</head>

<body class="bg-gray-900 text-white min-h-screen">

<div class="max-w-md mx-auto p-4 space-y-4">

  <!-- USER PROFILE -->
  <div class="bg-gray-800 p-4 rounded-2xl flex items-center gap-4 shadow">
    <img id="avatar" class="w-14 h-14 rounded-full"/>
    <div>
      <h2 class="text-lg font-bold">Alex Johnson</h2>
      <p id="userId" class="text-sm text-gray-400"></p>
    </div>
  </div>

  <!-- DAILY CHECKIN -->
  <div class="bg-gray-800 p-4 rounded-2xl shadow">
    <div class="flex justify-between items-center">
      <div>
        <h3 class="font-semibold">Daily Check-in</h3>
        <p id="streak">🔥 0 day streak</p>
      </div>
      <button onclick="checkIn()" class="bg-purple-500 px-4 py-2 rounded-xl hover:scale-105 transition">
        Check In
      </button>
    </div>
  </div>

  <!-- TASKS -->
  <div class="bg-gray-800 p-4 rounded-2xl shadow">
    <h3 class="mb-2 font-semibold">Total Points: <span id="points">0</span></h3>

    <div class="space-y-2">
      <label class="flex justify-between items-center">
        <span>Follow Twitter (+50)</span>
        <input type="checkbox" onchange="completeTask(50,this)">
      </label>

      <label class="flex justify-between items-center">
        <span>Join Telegram (+100)</span>
        <input type="checkbox" onchange="completeTask(100,this)">
      </label>

      <label class="flex justify-between items-center">
        <span>Share Post (+80)</span>
        <input type="checkbox" onchange="completeTask(80,this)">
      </label>
    </div>
  </div>

  <!-- REFER -->
  <div class="bg-gray-800 p-4 rounded-2xl shadow">
    <h3 class="font-semibold">Refer a Friend</h3>
    <p class="text-sm text-gray-400 mb-2">Earn 200 points per referral</p>

    <div class="bg-gray-700 p-2 rounded mb-2 text-center" id="refCode"></div>

    <button onclick="copyRef()" class="bg-blue-500 w-full py-2 rounded-xl">
      Copy Link
    </button>
  </div>

  <!-- WITHDRAW -->
  <div class="bg-gray-800 p-4 rounded-2xl shadow">
    <h3>💎 Balance: <span id="balance">0</span> pts</h3>

    <button id="withdrawBtn"
      onclick="withdraw()"
      class="mt-2 w-full py-2 rounded-xl bg-green-500 disabled:bg-gray-600">
      Withdraw
    </button>
  </div>

</div>

<!-- MODAL -->
<div id="modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center">
  <div class="bg-white text-black p-6 rounded-xl">
    <p>Withdrawal request sent (min 1000 pts)</p>
    <button onclick="closeModal()" class="mt-4 bg-purple-500 text-white px-4 py-2 rounded">OK</button>
  </div>
</div>

<script>

// INIT USER
function generateUID(){
  return "UID-" + Math.random().toString(36).substring(2,9).toUpperCase();
}

if(!localStorage.uid){
  localStorage.uid = generateUID();
}
document.getElementById("userId").innerText = localStorage.uid;

// Avatar
document.getElementById("avatar").src =
`https://api.dicebear.com/7.x/avataaars/svg?seed=${localStorage.uid}`;

// REF CODE
if(!localStorage.ref){
  localStorage.ref = "REF" + Math.random().toString(36).substring(2,8).toUpperCase();
}
document.getElementById("refCode").innerText = localStorage.ref;

// POINTS
let points = parseInt(localStorage.points || 0);
let streak = parseInt(localStorage.streak || 0);

updateUI();

function updateUI(){
  document.getElementById("points").innerText = points;
  document.getElementById("balance").innerText = points;
  document.getElementById("streak").innerText = "🔥 " + streak + " day streak";

  let btn = document.getElementById("withdrawBtn");
  btn.disabled = points < 1000;
}

// TASK
function completeTask(val,el){
  if(el.checked){
    points += val;
    localStorage.points = points;
    updateUI();
  }
}

// CHECKIN
function checkIn(){
  streak++;
  points += 20;

  localStorage.streak = streak;
  localStorage.points = points;

  alert("Check-in successful!");
  updateUI();
}

// COPY REF
function copyRef(){
  let link = "https://yourapp.com/ref/" + localStorage.ref;
  navigator.clipboard.writeText(link);
  alert("Copied!");
}

// WITHDRAW
function withdraw(){
  if(points >= 1000){
    document.getElementById("modal").classList.remove("hidden");
  }
}

function closeModal(){
  document.getElementById("modal").classList.add("hidden");
}

</script>

</body>
</html>
